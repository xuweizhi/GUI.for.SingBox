# Bind locally by default. Change to 0.0.0.0:18080 if you need remote access.
WEBUI_LISTEN=127.0.0.1:18080

# Leave empty to let the app generate data/webui-token with mode 0600.
# Authentication is always enabled, including loopback-only binds.
WEBUI_TOKEN=

# Optional: outbound proxy used by the service itself. These values never change the host proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost
